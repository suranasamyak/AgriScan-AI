# AgroScan AI - Backend Environment Variables
APP_ENV=development
APP_NAME="AgroScan AI"
DATABASE_URL=sqlite:///./agroscan.db
SECRET_KEY=replace_with_a_secure_random_secret_key_at_least_32_characters
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# AI Configuration (Optional but recommended for full conversational and vision grounded reasoning)
GEMINI_API_KEY=replace_with_your_gemini_api_key
